<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.example.testoflocalfx.HelloModsController"
          alignment="top_center" hgap="50" vgap="20"
          gridLinesVisible="true">
    <!-- Note default is to overlay each buttin in Center
    <Button text="1" />
    <Button text="2" />
    <Button text="3" />
    <Button text="4" />
    -->

    <padding><Insets top="150"/></padding>

    <Button text="1" GridPane.rowIndex="0" GridPane.columnIndex="0"
        GridPane.halignment="RIGHT"/>
    <Button text="2" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Button text="3" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <Button text="4" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Button text="Long Button" GridPane.rowIndex="2" GridPane.columnIndex="0"
        GridPane.columnSpan="2" GridPane.halignment="CENTER"/>


</GridPane>
